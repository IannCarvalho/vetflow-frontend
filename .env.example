# API Base URL - Change this to your backend server URL
VITE_API_BASE_URL=http://localhost:8080

# Demo mode. Set to "true" ONLY for the public portfolio demo deployment: it
# reveals an "Entrar como visitante" button on the sign-in screen that logs in
# with the seeded demo account. Must point VITE_API_BASE_URL at a demo backend
# (APP_ENV=demo). Leave unset/false for production.
# VITE_DEMO_MODE=false

# Assistente VetFlow (API do agente, serviço separado do backend).
# Default em dev: http://localhost:8700
VITE_AGENT_API_URL=http://localhost:8700

# Social OAuth Credentials
# Get your credentials from the provider's developer console

# Google OAuth 2.0
# https://console.cloud.google.com/
VITE_GOOGLE_CLIENT_ID=

# Facebook OAuth 2.0
# https://developers.facebook.com/apps/
VITE_FACEBOOK_APP_ID=

# Discord OAuth 2.0
# https://discord.com/developers/applications/
VITE_DISCORD_CLIENT_ID=
